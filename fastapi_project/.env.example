# ==============================================================================
# CONFIGURATION ENVIRONNEMENT - FASTAPI BONS DE COMMANDE (HEBERGEMENT LWS)
# ==============================================================================

# Nom et environnement de l'application
APP_NAME="Gestion Bons de Commande API"
APP_ENV="production"
DEBUG=False
SECRET_KEY="remplacer_par_une_cle_secrete_aleatoire_tres_longue_64_caracteres"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# URL de la base de données (SQLite par défaut, ou PostgreSQL/MySQL sur LWS)
# SQLite (simple, prêt à l'emploi) :
DATABASE_URL="sqlite:///./data/commandes.db"
# Exemple MySQL LWS cPanel :
# DATABASE_URL="mysql+pymysql://monuser_lws:MonMotDePasse@localhost/mabase_commandes"
# Exemple PostgreSQL LWS VPS :
# DATABASE_URL="postgresql://monuser:MonMotDePasse@localhost:5432/commandes_db"

# ==============================================================================
# PARAMÈTRES SMTP LWS (LIGNE WEB SERVICES)
# ==============================================================================
# Serveur SMTP sortant fourni par LWS :
# Option A (Mutualisé / cPanel / Webmail standard) : mail.lws.fr
# Option B (Avec votre domaine) : mail.votredomaine.com
# Option C (Serveur LWS dédié) : serveurXXX.lws-hosting.com
LWS_SMTP_HOST="mail.lws.fr"

# Port SMTP :
# 465 pour SSL (Fortement recommandé par LWS)
# 587 pour STARTTLS
LWS_SMTP_PORT=465

# Type de sécurité : True pour le port 465 (SSL), False pour 587 (TLS)
LWS_SMTP_USE_SSL=True
LWS_SMTP_USE_TLS=False

# Identifiants de votre compte email créé sur l'espace client LWS ou cPanel :
# Exemple : contact@votredomaine.com ou commandes@votredomaine.com
LWS_SMTP_USER="contact@votredomaine.com"
LWS_SMTP_PASSWORD="VotreMotDePasseEmailLWS"

# Expéditeur par défaut apparaissant sur les emails envoyés aux fournisseurs :
LWS_EMAIL_FROM="Service Achats <contact@votredomaine.com>"
LWS_EMAIL_REPLY_TO="achats@votredomaine.com"

# Nom de votre entreprise (apparaissant dans les modèles d'email et bons)
COMPANY_NAME="Mon Entreprise SAS"
COMPANY_SIRET="123 456 789 00012"
COMPANY_EMAIL="contact@votredomaine.com"
COMPANY_PHONE="+33 1 23 45 67 89"
COMPANY_ADDRESS="10 Rue du Commerce, 75001 Paris, France"

# CORS : URLs de votre application frontend autorisées à contacter l'API
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://votredomaine.com"]
